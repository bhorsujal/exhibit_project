# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///exhibit_monitor.db
# For PostgreSQL: postgresql://username:password@localhost/database_name

# File Processing Directories
INPUT_DIR=input_files
OUTPUT_DIR=output_files
ERROR_DIR=error_files

# Monitoring Settings
MONITOR_INTERVAL=30
MAX_FILE_SIZE=1073741824
STABLE_FILE_CHECK_INTERVAL=2.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=exhibit_monitor.log